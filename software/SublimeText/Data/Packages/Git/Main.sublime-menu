[
    {
        "id": "tools",
        "children":
        [
            {
                "caption": "Git",
                "children":
                [
                    {
                        "caption": "当前文件",
                        "children":
                        [
                             { "caption": "日志", "command": "git_log" }
                            ,{ "caption": "图形", "command": "git_graph" }
                            ,{ "caption": "-" }
                            ,{ "caption": "差异", "command": "git_diff" }
                            ,{ "caption": "差异（忽略空白）", "command": "git_diff", "args": { "ignore_whitespace": true } }
                            ,{ "caption": "差异工具", "command": "git_raw", "args": { "command": "git difftool", "append_current_file": true, "may_change_files": false } }
                            ,{ "caption": "-" }
                            ,{ "caption": "添加", "command": "git_raw", "args": { "command": "git add", "append_current_file": true } }
                            ,{ "caption": "添加选中块", "command": "git_add_selected_hunk" }
                            ,{ "caption": "-" }
                            ,{ "caption": "重置", "command": "git_raw", "args": { "command": "git reset HEAD", "append_current_file": true, "show_in": "suppress" } }
                            ,{ "caption": "检出（放弃更改）", "command": "git_raw", "args": { "command": "git checkout", "append_current_file": true } }
                            ,{ "caption": "-" }
                            ,{ "caption": "快速提交当前文件", "command": "git_quick_commit" }
                            ,{ "caption": "提交选中块", "command": "git_commit_selected_hunk" }
                            ,{ "caption": "-" }
                            ,{ "caption": "责任追溯", "command": "git_blame" }
                            ,{ "caption": "-" }
                            ,{ "caption": "切换标注", "command": "git_toggle_annotations" }
                        ]
                    }
                    ,{
                        "caption": "整个仓库",
                        "children":
                        [
                             { "caption": "日志", "command": "git_log_all" }
                            ,{ "caption": "图形", "command": "git_graph_all" }
                            ,{ "caption": "-" }
                            ,{ "caption": "差异", "command": "git_diff_all" }
                            ,{ "caption": "差异（忽略空白）", "command": "git_diff_all", "args": { "ignore_whitespace": true } }
                            ,{ "caption": "差异（已暂存）", "command": "git_diff_commit" }
                            ,{ "caption": "差异（已暂存，忽略空白）", "command": "git_diff_commit", "args": { "ignore_whitespace": true } }
                            ,{ "caption": "差异工具", "command": "git_raw", "args": { "command": "git difftool", "may_change_files": false } }
                            ,{ "caption": "强制重置", "command": "git_reset_hard_head" }
                            ,{ "caption": "-" }
                            ,{ "caption": "添加...", "command": "git_add_choice" }
                            ,{ "caption": "-" }
                            ,{ "caption": "重置", "command": "git_raw", "args": { "command": "git reset HEAD", "show_in": "suppress" } }
                            ,{ "caption": "-" }
                            ,{ "caption": "提交", "command": "git_commit" }
                            ,{ "caption": "修订上次提交", "command": "git_commit_amend" }
                            ,{ "caption": "-" }
                            ,{ "caption": "打开...", "command": "git_open_file" }
                            ,{ "caption": "打开配置", "command": "git_open_config_file" }
                            ,{ "caption": "打开链接", "command": "git_open_config_url", "args": { "url_param": "remote.origin.url" } }
                        ]
                    }
                    ,{
                        "caption": "储藏",
                        "children":
                        [
                             { "caption": "保存", "command": "git_raw", "args": { "command": "git stash", "may_change_files": true } }
                            ,{ "caption": "弹出", "command": "git_raw", "args": { "command": "git stash pop", "may_change_files": true } }
                            ,{ "caption": "应用", "command": "git_stash_apply" }
                            ,{ "caption": "删除", "command": "git_stash_drop" }
                            ,{ "caption": "列表", "command": "git_stash_list" }
                        ]
                    }
                    ,{ "caption": "-" }
                    ,{
                        "caption": "流程",
                        "children":
                        [
                            { "caption": "功能开始", "command": "git_flow_feature_start"}
                            ,{ "caption": "功能完成", "command": "git_flow_feature_finish"}
                            ,{ "caption": "-"}
                            ,{ "caption": "发布开始", "command": "git_flow_release_start"}
                            ,{ "caption": "发布完成", "command": "git_flow_release_finish"}
                            ,{ "caption": "-"}
                            ,{ "caption": "热修复开始", "command": "git_flow_hotfix_start"}
                            ,{ "caption": "热修复完成", "command": "git_flow_hotfix_finish"}
                        ]
                    }
                    ,{ "caption": "-" }
                    ,{ "caption": "初始化", "command": "git_init"}
                    ,{ "caption": "状态...", "command": "git_status" }
                    ,{ "caption": "分支...", "command": "git_branch" }
                    ,{ "caption": "合并...", "command": "git_merge" }
                    ,{ "caption": "查看提交历史...", "command": "git_commit_history"}
                ]
            }
        ]
    }

    ,{
        "caption": "Preferences",
        "mnemonic": "N",
        "id": "preferences",
        "children":
        [
            {
                "caption": "Package Settings",
                "mnemonic": "P",
                "id": "package-settings",
                "children":
                [
                    {
                        "caption": "Git",
                        "children":
                        [
                            {
                                "command": "open_file",
                                "args": {"file": "${packages}/Git/Git.sublime-settings"},
                                "caption": "设置 – 默认"
                            },
                            {
                                "command": "open_file",
                                "args": {"file": "${packages}/User/Git.sublime-settings"},
                                "caption": "设置 – 用户"
                            },
                            { "caption": "-" }
                        ]
                    }
                ]
            }
        ]
    }
]
