[
	{
		"caption": "File",
		"mnemonic": "F",
		"id": "file",
		"children": [
			{
				"command": "side_bar_save_as_admin",
				"caption": "以管理员身份另存为…"
			}
		]
	},
	{
		"id": "preferences",
		"children": [
			{
				"id": "package-settings",
				"children": [
					{
						"caption": "侧边栏",
						"children": [
							{
								"command": "open_file",
								"args": {
									"file": "${packages}/SideBarEnhancements/Side Bar.sublime-settings"
								},
								"caption": "设置 – 默认"
							},
							{
								"command": "open_file",
								"args": {
									"file": "${packages}/User/Side Bar.sublime-settings"
								},
								"caption": "设置 – 用户"
							},
							{ "caption": "-" },
							{
								"command": "open_file",
								"args": {
									"file": "${packages}/SideBarEnhancements/Default (OSX).sublime-keymap",
									"platform": "OSX"
								},
								"caption": "快捷键 – 默认"
							},
							{
								"command": "open_file",
								"args": {
									"file": "${packages}/SideBarEnhancements/Default (Linux).sublime-keymap",
									"platform": "Linux"
								},
								"caption": "快捷键 – 默认"
							},
							{
								"command": "open_file",
								"args": {
									"file": "${packages}/SideBarEnhancements/Default (Windows).sublime-keymap",
									"platform": "Windows"
								},
								"caption": "快捷键 – 默认"
							},
							{
								"command": "open_file",
								"args": {
									"file": "${packages}/User/Default (OSX).sublime-keymap",
									"platform": "OSX"
								},
								"caption": "快捷键 – 用户"
							},
							{
								"command": "open_file",
								"args": {
									"file": "${packages}/User/Default (Linux).sublime-keymap",
									"platform": "Linux"
								},
								"caption": "快捷键 – 用户"
							},
							{
								"command": "open_file",
								"args": {
									"file": "${packages}/User/Default (Windows).sublime-keymap",
									"platform": "Windows"
								},
								"caption": "快捷键 – 用户"
							},
							{ "caption": "-" }
						]
					}
				]
			}
		]
	}
]
