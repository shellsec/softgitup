{
    "git_platform": "github",
    "git_platform使用备注_选择通道": "github,gitlab,remote",
    "github_repo": "https://github.com/shellsec/softgitup",
    "gitlab_repo": "https://gitlab.com/shellsec/softgitup",
    "remote_server": "http://www.shellsec.com",
    "remote_server使用备注_会自动拼接": "http://www.shellsec.com/software/list.txt",
    "list_file": "list.txt",
    "sync_time": "07:00",
    "software_dirs": {
      "WinMemoryCleaner": "WinMemoryCleaner",      
      "NetTime": "NetTime",     
      "everything": "everything",    
      "Chrome": "Chrome",  
      "system_good": "system_good",
      "notepad++": "notepad++",
      "notepad--": "notepad--",            
      "CCleaner": "CCleaner",
      "WiseCare365": "WiseCare365",
      "EditPlus": "EditPlus",
      "EmEditor": "EmEditor",
      "HiBit Startup Manager": "HiBit Startup Manager",
      "SublimeText": "SublimeText",
      "WinRAR": "WinRAR",
      "7-Zip": "7-Zip", 
      "UltraEdit": "UltraEdit",
      "CrystalDiskInfo" : "CrystalDiskInfo",
      "lx-music-desktop": "lx-music-desktop",
      "typora": "typora",
      "PotPlayer": "PotPlayer",
      "gh-release-fetch": "gh-release-fetch"
    },
    "manager_base_path": "./software",
    "sync_base_path": "",
    "git_mirrors": [
      "https://gh-proxy.com/https://raw.githubusercontent.com/shellsec/softgitup"
    ],
    "download_timeout": 30,
    "retry_times": 3,
    "retry_delay": 5,
  "log_level": "INFO",
  "auto_start": true,
  "auto_kill": true,
  "process_map": {
    "notepad++": ["notepad++.exe"],
    "notepad-": ["Notepad--.exe"],
    "SublimeText": ["sublime_text.exe"],
    "EditPlus": ["EditPlus.exe"],
    "CCleaner": ["CCleaner.exe"],
    "everything": ["Everything.exe"],
    "UltraEdit": ["uedit64.exe", "uedit32.exe"],
    "7-Zip": ["7zFM.exe"],
    "WinRAR": ["WinRAR.exe"],
    "WinMemoryCleaner": ["WinMemoryCleaner.exe"],
    "NetTime": ["NetTimeService.exe", "NetTime.exe" ],
    "HiBit Startup Manager": ["HiBit Startup Manager.exe"],
    "CrystalDiskInfo": ["CrystalDiskInfo.exe"],
    "system_good": ["Keyvol.exe","putty.exe", "SmartDefrag-Pro.exe", "Ditto.exe", "DuplicateCleaner.exe", "DriverTalent.exe", "DefenderRemover.exe", "RevokeMsgPatcher.exe", "HEU_KMS_Activator.exe", "StartBack.exe", "StopUpdates10.exe"]
  },
  "start_map": {
    "notepad++": "notepad++.exe",
    "notepad-": "Notepad--.exe",
    "SublimeText": "sublime_text.exe",
    "EditPlus": "EditPlus.exe",
    "CCleaner": "CCleaner.exe",
    "everything": "Everything.exe",
    "UltraEdit": "uedit64.exe",
    "7-Zip": "7zFM.exe",
    "WinRAR": "WinRAR.exe",
    "WinMemoryCleaner": "WinMemoryCleaner.exe",
    "NetTime": ["NetTimeService.exe", "NetTime.exe" ],
    "HiBit Startup Manager": "HiBit Startup Manager.exe",
    "CrystalDiskInfo": "CrystalDiskInfo.exe"
  },
  "service_map": {
    "NetTimeService.exe": "NetTimeSvc",
    "Everything": "Everything"
  },
  "start_after_update": [
    "NetTime",
    "WinMemoryCleaner"
  ],
  "check_interval": 3600
}